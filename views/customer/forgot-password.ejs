<%- include("../partials/header", { title: "Forgot Password" }) %>
<div class="form-box">
    <h1>Forgot Password</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form action="/customer/forgot-password" method="POST">
        <label>Email</label>
        <input type="email" name="email" required>
        <button class="btn">Send OTP</button>
    </form>
    <p><a href="/customer/login">Back to Login</a></p>
</div>
<%- include("../partials/footer") %>
