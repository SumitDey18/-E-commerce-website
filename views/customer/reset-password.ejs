<%- include("../partials/header", { title: "Reset Password" }) %>
<div class="form-box">
    <h1>Reset Password</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form action="/customer/reset-password" method="POST">
        <input type="hidden" name="email" value="<%= email %>">
        <label>OTP</label>
        <input name="otp" inputmode="numeric" maxlength="6" required>
        <label>New Password</label>
        <div class="password-wrap"><input type="password" name="password" id="resetPassword" minlength="6" required><button type="button" class="toggle-password" onclick="togglePassword('resetPassword', this)">👁</button></div>
        <label>Confirm Password</label>
        <div class="password-wrap"><input type="password" name="confirmPassword" id="confirmPassword" minlength="6" required><button type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)">👁</button></div>
        <button class="btn">Reset Password</button>
    </form>
    <p><a href="/customer/login">Back to Login</a></p>
</div>
<script>function togglePassword(id,btn){const input=document.getElementById(id);input.type=input.type==='password'?'text':'password';btn.textContent=input.type==='password'?'👁':'🙈';}</script>
<%- include("../partials/footer") %>
