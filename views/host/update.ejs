<%- include("../partials/header", { title: "Update Product" }) %>
<div class="form-box">
    <h1>Update Product</h1>
    <form action="/host/products/<%= product._id %>/update" method="POST">
        <label>Name</label><input name="name" value="<%= product.name %>" required>
        <label>Category</label>
        <select name="category" required>
            <% (categories || []).forEach(category => { %><option value="<%= category %>" <%= (product.category || "Other") === category ? "selected" : "" %>><%= category %></option><% }) %>
        </select>
        <label>Price</label><input type="number" name="price" value="<%= product.price %>" min="0" step="0.01" required>
        <label>Description</label><textarea name="description"><%= product.description || "" %></textarea>
        <label>Quantity</label><input type="number" name="quantity" value="<%= product.quantity %>" min="0" required>
        <button class="btn">Update Product</button>
    </form>
    <br><a href="/host/products">Back to Products</a>
</div>
<%- include("../partials/footer") %>
