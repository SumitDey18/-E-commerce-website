<%- include("../partials/header", { title: "Dashboard" }) %>
<h1><%= user.role === "admin" ? "Admin Product Dashboard" : "Host Dashboard" %></h1>
<h2>Welcome <%= user.name %></h2>
<p>Role: <b><%= user.role %></b></p>
<div class="dashboard">
    <div class="dashboard-card"><h2>Upload Product</h2><p>Add a product with image.</p><a class="btn" href="/host/upload">Upload Product</a></div>
    <div class="dashboard-card"><h2>Products</h2><p><%= user.role === "admin" ? "Manage all products." : "Manage your products." %></p><a class="btn" href="/host/products">View Products</a></div>
    <% if (user.role === "admin") { %><div class="dashboard-card"><h2>Admin</h2><a class="btn" href="/admin">Admin Dashboard</a></div><% } %>
</div>
<%- include("../partials/footer") %>
