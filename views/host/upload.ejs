<%- include("../partials/header", { title: "Upload Product" }) %>
<div class="form-box">
    <h1>Upload Product</h1>
    <form action="/host/upload" method="POST" enctype="multipart/form-data">
        <label>Product Name</label><input type="text" name="name" required>
        <label>Category</label>
        <select name="category" required>
            <% (categories || []).forEach(category => { %><option value="<%= category %>"><%= category %></option><% }) %>
        </select>
        <label>Price</label><input type="number" name="price" min="0" step="0.01" required>
        <label>Description</label><textarea name="description"></textarea>
        <label>Quantity</label><input type="number" name="quantity" min="0" step="1" required>
        <label>Product Image</label><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp" required>
        <p>Maximum image size: 5 MB.</p>
        <button class="btn">Upload Product</button>
    </form>
</div>
<%- include("../partials/footer") %>
